{
  "$schema": "https://tr.designtokens.org/format/",
  "color": {
    "primitive": {
      "neutral": {
        "0": { "$type": "color", "$value": "oklch(0 0 0)" },
        "50": { "$type": "color", "$value": "oklch(0.98 0.005 250)" },
        "100": { "$type": "color", "$value": "oklch(0.95 0.005 250)" },
        "900": { "$type": "color", "$value": "oklch(0.20 0.01 250)" },
        "1000": { "$type": "color", "$value": "oklch(0.15 0.01 250)" }
      },
      "brand": {
        "primary": { "$type": "color", "$value": "oklch(0.85 0.20 130)" },
        "secondary": { "$type": "color", "$value": "oklch(0.60 0.15 250)" },
        "accent": { "$type": "color", "$value": "oklch(0.70 0.18 30)" }
      }
    },
    "semantic": {
      "clinical": {
        "background": { "$type": "color", "$value": "{color.primitive.neutral.50}" },
        "surface": { "$type": "color", "$value": "oklch(1 0 0)" },
        "text": { "$type": "color", "$value": "{color.primitive.neutral.900}" }
      },
      "adrenaline": {
        "background": { "$type": "color", "$value": "{color.primitive.neutral.0}" },
        "surface": { "$type": "color", "$value": "{color.primitive.neutral.1000}" },
        "text": { "$type": "color", "$value": "{color.primitive.neutral.50}" }
      }
    }
  },
  "spacing": {
    "primitive": {
      "base": { "$type": "dimension", "$value": "0.25rem" },
      "0": { "$type": "dimension", "$value": "0rem" },
      "1": { "$type": "dimension", "$value": "0.25rem" },
      "2": { "$type": "dimension", "$value": "0.5rem" },
      "4": { "$type": "dimension", "$value": "1rem" },
      "6": { "$type": "dimension", "$value": "1.5rem" },
      "8": { "$type": "dimension", "$value": "2rem" }
    },
    "semantic": {
      "container": { "$type": "dimension", "$value": "{spacing.primitive.8}" },
      "card": { "gap": { "$type": "dimension", "$value": "{spacing.primitive.6}" } }
    }
  }
}
