# Bienestar APP - Environment Variables Template
# Copy to .env and fill in your values
# ⚠️ NEVER commit .env to version control

# =============================================================================
# ENVIRONMENT & CORE
# =============================================================================
ENVIRONMENT=development  # development, staging, production
APP_NAME=Bienestar APP
DEBUG=false  # Set to true only for local development

# =============================================================================
# DATABASE (PostgreSQL Asyncpg)
# =============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:bienestar_dev_2026@localhost:5432/bienestar

# =============================================================================
# SECURITY (REQUIRED IN PRODUCTION)
# =============================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS - Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,https://app.bienestaros.com

# =============================================================================
# REDIS & CELERY (Distributed Queues & Caching)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# =============================================================================
# AI ENGINES & LLMS
# =============================================================================
OPENAI_API_KEY=sk-your-openai-key-here
GOOGLE_API_KEY=your-google-gemini-api-key-here

# =============================================================================
# DIETQA & KNOWLEDGE GRAPH (Neo4j)
# =============================================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# =============================================================================
# EMAIL NOTIFICATIONS (Resend)
# =============================================================================
RESEND_API_KEY=re_your_resend_api_key_here

# =============================================================================
# PAYMENT GATEWAYS (Stripe & Mercado Pago)
# =============================================================================
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
MP_ACCESS_TOKEN=APP_USR-your-mercadopago-access-token
MP_WEBHOOK_SECRET=your-mercadopago-webhook-secret

# =============================================================================
# GOOGLE OAUTH 2.0 (Phase 17)
# =============================================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# WHATSAPP BUSINESS API (Module B)
# =============================================================================
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# =============================================================================
# OBSERVABILITY & SENTRY
# =============================================================================
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# =============================================================================
# FEATURE FLAGS (Dark Launch & Feature Gates)
# =============================================================================
FF_COMPASSION_ENGINE=false
FF_MAGIC_IMPORT_V2=true
FF_CHECKOUT_V2=false
FF_EXCLUDE_GHOST_ATHLETES=true
